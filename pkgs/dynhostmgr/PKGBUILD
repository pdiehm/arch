# shellcheck disable=SC2034,SC2154,SC2164

pkgname="dynhostmgr"
pkgver="1.0.0"
pkgrel=1
arch=("x86_64")
license=("MIT")
makedepends=("rust")

prepare() {
  cd "$startdir/dynhostmgr"
  cargo fetch --locked
}

build() {
  cd "$startdir/dynhostmgr"
  cargo build --frozen --release
}

package() {
  cd "$startdir/dynhostmgr"
  install -Dm755 target/release/dynhostmgr "$pkgdir/usr/bin/dynhostmgr"
}
