# shellcheck disable=SC2034,SC2154,SC2164

pkgname="dynhostmgr"
pkgver="1.0.0"
pkgrel=1
arch=("x86_64")
license=("MIT")
makedepends=("rust")
source=("dynhostmgr.service")
sha256sums=("SKIP")

prepare() {
  cp -r "$startdir/dynhostmgr" .

  cd dynhostmgr
  cargo fetch --locked
}

build() {
  cd dynhostmgr
  cargo build --frozen --release
}

package() {
  install -Dm755 dynhostmgr/target/release/dynhostmgr "$pkgdir/usr/bin/dynhostmgr"
  install -Dm644 dynhostmgr.service "$pkgdir/usr/lib/systemd/system/dynhostmgr.service"
}
