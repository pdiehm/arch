# shellcheck disable=SC2034,SC2154,SC2218

pkgver() {
  local ref
  read -r _ ref <<< "$(git ls-remote --tags --refs "$url" | tail -n 1)"
  printf "%s" "${ref#refs/tags/v}"
}

pkgname="prettier-plugin-css-order"
pkgver="1.0.0"
pkgrel=1
pkgdesc="Prettier plugin to sort CSS declarations in a certain order"
arch=("any")
url="https://github.com/Siilwyn/prettier-plugin-css-order"
license=("ISC")
depends=("prettier" "nodejs")
makedepends=("git" "npm" "jq")
source=("$pkgname.tgz::https://registry.npmjs.org/$pkgname/-/$pkgname-$(pkgver).tgz")
noextract=("$pkgname.tgz")
sha256sums=("SKIP")

package() {
  npm install -g --prefix "$pkgdir/usr" --no-bin-links "$srcdir/$pkgname.tgz"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "../../../lib/node_modules/$pkgname/license.md" "$pkgdir/usr/share/licenses/$pkgname/"

  local mainjson="$pkgdir/usr/lib/node_modules/$pkgname/package.json"
  find "$pkgdir/usr" -type f -name package.json -print0 | while read -rd "" json; do
    tempjson="$(mktemp)"
    if [[ $json = "$mainjson" ]]; then
      jq 'with_entries(select(.key | test("^_.+") | not))' "$json" > "$tempjson"
    else
      jq "del(._where, .man)" "$json" > "$tempjson"
    fi

    cp "$tempjson" "$json"
  done

  find "$pkgdir/usr" -type d -exec chmod 755 "{}" +
  chown -R root:root "$pkgdir"
}
