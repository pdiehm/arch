[connection]
id=$NAME
type=wifi
autoconnect-priority=$PRIORITY

[wifi]
mode=infrastructure
ssid=$SSID

[wifi-security]
key-mgmt=wpa-eap

[802-1x]
eap=tls
identity=$IDENTITY
private-key-password=$PASSWORD
private-key=/etc/NetworkManager/system-connections/$NAME/private-key
client-cert=/etc/NetworkManager/system-connections/$NAME/client-cert
ca-cert=/etc/NetworkManager/system-connections/$NAME/ca-cert
