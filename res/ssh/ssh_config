Host *
  ControlMaster auto
  ControlPath ~/.ssh/.ctl-%h-%C
  ControlPersist 600
  IdentitiesOnly yes

Host arch
  IdentityFile ~/.ssh/arch
  Port 1970

Host bowser
  IdentityFile ~/.ssh/bowser
  ForwardAgent yes
  Port 1970

Host goomba
  IdentityFile ~/.ssh/goomba
  ForwardAgent yes
  Port 1970

Host github.com
  IdentityFile ~/.ssh/github
