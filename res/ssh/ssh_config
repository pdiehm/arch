Host *
  ControlMaster auto
  ControlPath ~/.ssh/.%r@%h:%p
  ControlPersist 600
  IdentitiesOnly yes
  SetEnv TERM=xterm-256color

Host pascal-pc
  IdentityFile ~/.ssh/pascal-pc
  Port 1970

Host pascal-laptop
  IdentityFile ~/.ssh/pascal-laptop
  Port 1970

Host bowser
  IdentityFile ~/.ssh/bowser
  ForwardAgent yes
  Port 1970

Host goomba
  IdentityFile ~/.ssh/goomba
  ForwardAgent yes
  Port 1970

Host github.com
  IdentityFile ~/.ssh/github

Host gitlab.informatik.uni-wuerzburg.de
  IdentityFile ~/.ssh/uni-gitlab
