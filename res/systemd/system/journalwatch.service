[Unit]
Description=Watch journalctl and report relevant events to ntfy
Requires=network-online.target
After=network-online.target

[Service]
TimeoutStartSec=infinity
ExecStartPre=/bin/sh -c 'until nc -z ntfy.pdiehm.dev 80; do sleep 1; done'
ExecStart=/usr/local/lib/journalwatch/journalwatch.sh

[Install]
WantedBy=multi-user.target
