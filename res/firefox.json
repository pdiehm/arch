    "SearchEngines": {
      "Default": "DuckDuckGo",
      "Remove": ["Bing", "Ecosia", "Google", "Perplexity"],

      "Add": [
        {
          "Name": "AUR",
          "Alias": "@aur",
          "URLTemplate": "https://aur.archlinux.org/packages?K={searchTerms}",
          "IconURL": "https://aur.archlinux.org/favicon.ico"
        },
        {
          "Name": "Arch Packages",
          "Alias": "@ap",
          "URLTemplate": "https://archlinux.org/packages?q={searchTerms}",
          "IconURL": "https://archlinux.org/favicon.ico"
        },
        {
          "Name": "Arch Wiki",
          "Alias": "@aw",
          "URLTemplate": "https://wiki.archlinux.org/index.php?search={searchTerms}",
          "IconURL": "https://wiki.archlinux.org/favicon.ico"
        },
        {
          "Name": "Crates",
          "Alias": "@crates",
          "URLTemplate": "https://crates.io/search?q={searchTerms}",
          "IconURL": "https://crates.io/favicon.ico"
        },
        {
          "Name": "Devhints",
          "Alias": "@devhints",
          "URLTemplate": "https://devhints.io/{searchTerms}",
          "IconURL": "https://devhints.io/assets/favicon.png"
        },
        {
          "Name": "Docker",
          "Alias": "@docker",
          "URLTemplate": "https://hub.docker.com/search?q={searchTerms}",
          "IconURL": "https://hub.docker.com/favicon.ico"
        },
        {
          "Name": "Filetype",
          "Alias": "@file",
          "URLTemplate": "https://fileinfo.com/extension/{searchTerms}",
          "IconURL": "https://fileinfo.com/favicon.ico"
        },
        {
          "Name": "GitHub",
          "Alias": "@gh",
          "URLTemplate": "https://github.com/search?q={searchTerms}",
          "IconURL": "https://github.com/favicon.ico"
        },
        {
          "Name": "GitHub Actions",
          "Alias": "@gha",
          "URLTemplate": "https://github.com/marketplace?type=actions&query={searchTerms}",
          "IconURL": "https://github.com/favicon.ico"
        },
        {
          "Name": "IP Address",
          "Alias": "@ip",
          "URLTemplate": "https://ipinfo.io/{searchTerms}",
          "IconURL": "https://ipinfo.io/favicon.ico"
        },
        {
          "Name": "MAC Address",
          "Alias": "@mac",
          "URLTemplate": "https://maclookup.app/search/result?mac={searchTerms}",
          "IconURL": "https://maclookup.app/img/ico/favicon.ico"
        },
        {
          "Name": "MDN",
          "Alias": "@mdn",
          "URLTemplate": "https://developer.mozilla.org/search?q={searchTerms}",
          "IconURL": "https://developer.mozilla.org/favicon.svg"
        },
        {
          "Name": "NPM",
          "Alias": "@npm",
          "URLTemplate": "https://npmjs.com/search?q={searchTerms}",
          "IconURL": "https://static-production.npmjs.com/b0f1a8318363185cc2ea6a40ac23eeb2.png"
        },
        {
          "Name": "Nix Packages",
          "Alias": "@np",
          "URLTemplate": "https://search.nixos.org/packages?channel=unstable&query={searchTerms}",
          "IconURL": "https://search.nixos.org/favicon-96x96.png"
        },
        {
          "Name": "NixOS Options",
          "Alias": "@no",
          "URLTemplate": "https://search.nixos.org/options?channel=unstable&query={searchTerms}",
          "IconURL": "https://search.nixos.org/favicon-96x96.png"
        },
        {
          "Name": "NixOS Wiki",
          "Alias": "@nw",
          "URLTemplate": "https://wiki.nixos.org/w/index.php?search={searchTerms}",
          "IconURL": "https://wiki.nixos.org/favicon.ico"
        },
        {
          "Name": "Port",
          "Alias": "@port",
          "URLTemplate": "https://speedguide.net/port.php?port={searchTerms}",
          "IconURL": "https://speedguide.net/favicon.ico"
        },
        {
          "Name": "Texdoc",
          "Alias": "@tex",
          "URLTemplate": "https://texdoc.org/serve/{searchTerms}/0",
          "IconURL": "https://texdoc.org/images/icon.png"
        },
        {
          "Name": "YouTube",
          "Alias": "@yt",
          "URLTemplate": "https://youtube.com/results?search_query={searchTerms}",
          "IconURL": "https://youtube.com/favicon.ico"
        },
        {
          "Name": "YouTube Music",
          "Alias": "@ytm",
          "URLTemplate": "https://music.youtube.com/search?q={searchTerms}",
          "IconURL": "https://music.youtube.com/favicon.ico"
        }
      ]
    }
