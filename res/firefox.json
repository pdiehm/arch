      { "Title": "HomeAssistant", "URL": "http://homeassistant:8123", "Placement": "toolbar" },

      { "Title": "Amazon", "URL": "https://amazon.de", "Placement": "menu" },
      { "Title": "Arch Linux", "URL": "https://archlinux.org", "Placement": "menu" },
      { "Title": "Bitwarden", "URL": "https://bitwarden.com", "Placement": "menu" },
      { "Title": "Brilliant", "URL": "https://brilliant.org", "Placement": "menu" },
