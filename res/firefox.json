      { "Title": "YouTube", "URL": "https://youtube.com", "Placement": "toolbar", "Folder": "Google" },
      { "Title": "YouTube Music", "URL": "https://music.youtube.com", "Placement": "toolbar", "Folder": "Google" },

      { "Title": "WueStudy", "URL": "https://wuestudy.zv.uni-wuerzburg.de", "Placement": "toolbar", "Folder": "Uni" },
      { "Title": "WueCampus", "URL": "https://wuecampus.uni-wuerzburg.de", "Placement": "toolbar", "Folder": "Uni" },
