      { "Title": "Unicode", "URL": "https://symbl.cc/en/unicode-table", "Placement": "menu" }
    ],

    "ExtensionSettings": {
      "*": { "installation_mode": "blocked" },

      "{446900e4-71c2-419f-a6a7-df9c091e268b}": {
        "_name": "Bitwarden",
        "installation_mode": "force_installed",
        "default_area": "navbar",
        "private_browsing": false
      },

      "uBlock0@raymondhill.net": {
        "_name": "uBlock Origin",
        "installation_mode": "force_installed",
        "default_area": "menupanel",
        "private_browsing": true
      },

      "{d7742d87-e61d-4b78-b8a1-b469842139fa}": {
        "_name": "Vimium",
        "installation_mode": "force_installed",
        "default_area": "menupanel",
        "private_browsing": true
      }
    },

    "Preferences": {
      "browser.newtabpage.activity-stream.hideLogo": { "Value": true, "Locked": true },
      "browser.newtabpage.activity-stream.newtabWallpapers.user.enabled": { "Value": true, "Locked": true },
      "browser.newtabpage.activity-stream.newtabWallpapers.wallpaper": { "Value": "starry-sky", "Locked": true },
      "browser.translations.automaticallyPopup": { "Value": false, "Locked": true },
      "media.webspeech.synth.enabled": { "Value": false, "Locked": true },
      "places.history.enabled": { "Value": false, "Locked": true }
    },

    "SearchEngines": {
      "Default": "DuckDuckGo",
      "Remove": ["Google", "Bing", "Ecosia", "Perplexity", "Startpage", "Wikipedia (en)"],
      "PreventInstalls": true,

      "Add": [
        { "Name": "AUR", "Alias": "@aur", "URLTemplate": "https://aur.archlinux.org/packages?K={searchTerms}" },
        { "Name": "Arch Packages", "Alias": "@ap", "URLTemplate": "https://archlinux.org/packages?q={searchTerms}" },
        { "Name": "Arch Wiki", "Alias": "@aw", "URLTemplate": "https://wiki.archlinux.org/index.php?search={searchTerms}" },
        { "Name": "Crates", "Alias": "@crates", "URLTemplate": "https://crates.io/search?q={searchTerms}" },
        { "Name": "Docker", "Alias": "@docker", "URLTemplate": "https://hub.docker.com/search?q={searchTerms}" },
        { "Name": "File Info", "Alias": "@file", "URLTemplate": "https://fileinfo.com/extension/{searchTerms}" },
        { "Name": "GitHub", "Alias": "@gh", "URLTemplate": "https://github.com/search?q={searchTerms}" },
        { "Name": "GitHub Actions", "Alias": "@gha", "URLTemplate": "https://github.com/marketplace?type=actions&query={searchTerms}" },
        { "Name": "IP Info", "Alias": "@ip", "URLTemplate": "https://ipinfo.io/{searchTerms}" },
        { "Name": "MDN", "Alias": "@mdn", "URLTemplate": "https://developer.mozilla.org/search?q={searchTerms}" },
        { "Name": "NPM", "Alias": "@npm", "URLTemplate": "https://www.npmjs.com/search?q={searchTerms}" },
        { "Name": "Nix Options", "Alias": "@no", "URLTemplate": "https://search.nixos.org/options?query={searchTerms}" },
        { "Name": "Nix Packages", "Alias": "@np", "URLTemplate": "https://search.nixos.org/packages?query={searchTerms}" },
        { "Name": "NixOS Wiki", "Alias": "@nw", "URLTemplate": "https://wiki.nixos.org/w/index.php?search={searchTerms}" },
        { "Name": "Port", "Alias": "@port", "URLTemplate": "https://www.speedguide.net/port.php?port={searchTerms}" },
        { "Name": "Shell Check", "Alias": "@sc", "URLTemplate": "https://www.shellcheck.net/wiki/SC{searchTerms}" },
        { "Name": "Texdoc", "Alias": "@tex", "URLTemplate": "https://texdoc.org/serve/{searchTerms}/0" },
        { "Name": "YouTube", "Alias": "@yt", "URLTemplate": "https://www.youtube.com/results?search_query={searchTerms}" },
        { "Name": "YouTube Music", "Alias": "@ytm", "URLTemplate": "https://music.youtube.com/search?q={searchTerms}" }
      ]
    }
  }
}
