      { "Title": "NixOS Manual", "URL": "https://nixos.org/manual/nixos/stable", "Placement": "menu" },
      { "Title": "Nixpkgs Manual", "URL": "https://nixos.org/manual/nixpkgs/stable", "Placement": "menu" },
